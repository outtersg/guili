for modif in true $modifsPostConf ; do $modif ; done

echo Compilation… >&2
export DYLD_LIBRARY_PATH="`pwd`/lib" # Car utilise dans la génération les biblios produites.
make -j4

echo Installation… >&2
sudo make install

sutiliser
