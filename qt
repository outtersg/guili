fqtnConst()
{
	# Une 6.7 avec un clang 19 pète dans qdoc sur 3 erreurs, qui semblent être un durcissement de clang face aux tentatives d'extraction de type C++ sur des const tandis que lui attend des non const.
	# Confirmé en regardant le source d'une 6.8, qui inclut des blocs spécifiques #if LIBCLANG_VERSION_MAJOR >= 19
	
	case "$CC" in clang*) true ;; *) return 0 ;; esac
	local vclang="`versionCompiloChemin clang`"
	pge $vclang 19 || return 0
	modifsPostConf="$modifsPostConf _fqtnConst"
}

_fqtnConst()
{
	filtrer qttools/src/qdoc/qdoc/src/qdoc/clangcodeparser.cpp sed \
		-e '/get_fully_qualified_type_name/s/getDefaultArgument(),/getDefaultArgument().getArgument().getAsType(),/' \
		-e '/get_expression_as_string/s/getDefaultArgument(),/getDefaultArgument().getSourceExpression(),/' \
		-e 's/TemplateName::Qualified::Fully/TemplateName::Qualified::AsWritten/'
}

qtcopy()
{
	local version=r619081
	local archive_svn=svn://anonsvn.kde.org/home/kde/trunk/qt-copy/patches
	pushd . > /dev/null
	pushd /tmp > /dev/null
	obtenirEtAllerDansVersion
	ou="`pwd`"
	popd > /dev/null
	mv "$ou" patches
	for i in patches/*-*.diff
	do
		patch -p0 < "$i" || true # Certains sont vides.
	done
}

# Variables

archive=https://github.com/qt/qt5/archive/refs/tags/v$version`[ -z "$lts" ] || printf %s -lts-lgpl`.tar.gz
#archive_git=https://github.com/qt/qt5.git@$version # Surtout pas, car la structure à 2 étages fait que qt/playground/jenesaisplusquoi n'existe pas.
vgit=$version # La branche
pge $version 6 || vgit=v$version-lts-lgpl # L'étiquette
archive_git=https://code.qt.io/qt/qt5.git@$vgit
# Ce crétin de cmake utilise l'@ comme séparateur, dans qtshadertools/tools/qsb/Qt6ShaderToolsMacros.cmake
# résultat, son passage de paramètres truc:muche:$TMP/qt5@6.1.11.6.1.11.HEAD/etc. (format <option>:<option>:<chemin>) est découpé en deux blocs, le premier ayant un chemin incomplet, le second n'ayant pas de chemin (le 6.1.11.HEAD/etc. est vu comme l'<option> 1): list index: 2 out of range (-1, 0)
# On utilise donc un séparateur plus neutre (ni @, ni ;, ni :):
guili_etiquette_sep=_

destiner

prerequis

obtenirEtAllerDansVersion

echo Correction… >&2
for modif in true $modifs ; do $modif ; done

echo Configuration… >&2
# En l'absence de réseau sur une copie déjà extraite:
#filtrer cmake/QtIRGitHelpers.cmake sed -e 's/NOT should_clone AND arg_FETCH/FALSE AND &/'
if pge $version 5 && pg 6 $version ; then OPTIONS_CONF="$OPTIONS_CONF -opensource -confirm-license" ; fi # Sinon il emmerde avec demande de validation manuelle.
./configure --prefix="$dest" $OPTIONS_CONF
