prerequisOptionnels()
{
	# N.B.: pour openssl, on ne bénéficiera pas de l'option automatique +osslxx, car la détection est faite sur la présence d'une ligne contenant une affectation d'openssl à prerequis me semble-t-il. Or on veut pouvoir se garder la liberté de ne pas l'embarquer.
	for p in \
		ninja gn pkgconf \
		python re2 \
		zlib iconv icu pcre \
		libxml libxslt \
		libevent glib dbus \
		freetype harfbuzz fontconfig \
		lcms libjpeg libpng libtiff \
		postgresql sqlite mysql \
		nss "openssl $v_ossl" \
		opus ffmpeg
do
	versions $p | grep -q . && prerequis="$prerequis $p" || true
done
	
	case `uname` in
		FreeBSD)
			# Sur un FreeBSD contenant des paquets pkg, le mtdev installé peut faire référence à <linux/input.h> qui n'existe pas.
			# Et notre contournement habituel (linuxInput() dans util.util.sys.sh) n'est pas pris en compte par CMake, qui ne prend des -I que ceux qui lui assurent la présence de certains .h, dont mtdev.h, mais pas input.h.
			# On n'a donc d'autre possibilité qu'installer notre version de mtdev; avec en plus l'option +linuxinput, car ces gros malins de qt, même s'ils détectent bien notre $INSTALLS/mtdev-1.x/include, le placent juste après /usr/local/include, ce qui fait que le mtdev.h pourri est pris quand même. Mais notre option +linuxinput installant <linux/input.h>, ouf, au moins le mtdev.h ne se casse plus les dents en allant en chercher un.
			{ grep -q linux.input.h < /usr/local/include/mtdev.h ; } 2> /dev/null && prerequis="$prerequis mtdev+linuxinput" || true
			;;
	esac
}

choixConstructeur()
{
	# Choisit l'outil de construction en fonction de ce que cmake aura généré.
	# Le fait de choisir les prérequis dynamiquement peut l'avoir incité à basculer vers ninja.
	# À invoquer après la construction.
	
	constr="make -j4"
	
	if [ -f build.ninja ] ; then constr=ninja ; fi
}

x11Introuvable()
{
	# lld n'inclut pas par défaut /usr/local/lib, où se trouvent les ports FreeBSD, dont par exemple libX11.so.
	
	{ echo '#include <X11/Xlib.h>' ; echo 'int main(int argc, char ** argv) { return NULL != XOpenDisplay(""); }' ; } > $TMP/$$/1.c
	
	# Ça c'est ce que fait Qt tout seul, si ça passe pas la peine de triturer plus loin.
	if compilable_c $TMP/$$/1.c -I/usr/local/include -lX11 ; then return 0 ; fi
	
	if compilable_c $TMP/$$/1.c -I/usr/local/include -L/usr/local/lib -lX11
	then
		# https://unix.stackexchange.com/questions/411355/cmake-to-recognize-library-path-installed-in-usr-local
		# https://cmake.org/cmake/help/book/mastering-cmake/chapter/System%20Inspection.html
		# https://github.com/conan-io/conan/issues/11688 très intéressant sur comment les outils FreeBSD divergent les uns des autres sur l'inclusion d'/usr/local/lib
		# Les options sur lesquelles jouer (LINK_OPTIONS) sont décrites dans qtbase/cmake/QtTargetHelpers.cmake
		# Notons aussi que CMakeFiles/CMakeConfigureLog.yaml inclut une recherche (et une trouvaille!) des 3 biblios: ne pourrait-on pas récupérer ces variables:
		# - X11_X11_LIB / pkgcfg_lib_PKG_X11_XCB_X11 / pkgcfg_lib_XRender_X11 / pkgcfg_lib_PC_GSTREAMER_GLX11_X11 / pkgcfg_lib_X11_X11
		# - X11_Xrandr_LIB / pkgcfg_lib_XRANDR_Xrandr
		# - X11_Xext_LIB
		# D'autre part les .prl à certains niveaux (qtbase/lib/libQt6FFmpegMediaPluginImpl.prl) incluent bien le -L/usr/local/lib sans qu'on ait fait quoi que ce soit pour. Sont-ce eux les utilisateurs de ces variables?
		
		# En fait l'option -L doit être glissée dans les LIBRARIES elles-mêmes (CMake comprend que c'est un chemin de biblios, et non une biblio), pas en tant que LINK_OPTIONS qui est ignorée.
		filtrer qtmultimedia/src/plugins/multimedia/ffmpeg/CMakeLists.txt awk 'retention{print retention;if($0~/X11|Xrandr|Xext/)print"\"-L/usr/local/lib\"";retention=""}/LIBRARIES/{retention=$0;next}{print}'
	else
		# Bon a priori il détecterait bien tout seul mais soyons prudents:
		filtrer qtmultimedia/src/plugins/multimedia/ffmpeg/CMakeLists.txt sed -e s/QT_FEATURE_xlib/FALSE/g
	fi
}

resolveMultimedia()
{
	# In qtmultimedia/src/multimedia/pipewire/qpipewire_symbolloader_p.h
	# file not found: #include <QtMultimedia/private/qsymbolsresolveutils_p.h>
	# Et pourtant un FreeBSD 15 peut avoir un pipewire lui aussi (qui est d'ailleurs détecté par l'appelant, d'où sa surprise de ne pas trouver le .h correspondant).
	
	filtrer qtmultimedia/src/multimedia/CMakeLists.txt sed -e '/QT_FEATURE_library/s/LINUX OR ANDROID/& OR FREEBSD/'
}

kqueueEtInotify()
{
	# qtbase/src/corelib/io/qfilesystemwatcher.cpp essaie l'un après l'autre USE_INOTIFY puis Q_OS_FREEBSD (condition qui va invoquer des classes définies dans qfilesystemwatcher_kqueue.cpp).
	# Mais le CMakeLists.txt, lui, n'inclut qfilesystemwatcher_kqueue.cpp que si NOT QT_FEATURE_inotify AND FREEBSD.
	# Or les FreeBSD récents (14? 15?) incluent une couche de compatibilité inotify.
	# Donc le .cpp n'est pas inclus: undefined reference to `QKqueueFileSystemWatcherEngine::create(QObject*)'
	filtrer qtbase/src/corelib/CMakeLists.txt sed -e '/FREEBSD/s/NOT QT_FEATURE_inotify AND //'
}

environFreeBSD()
{
	# Sous FreeBSD, environ et __progname sont indéfinis (à définir par l'exécutable). Donc une biblio (libQtbase) compilée en -Wl,--no-undefined pète si un de ses composants exploite ces infos (ex.: qprocess_unix.cpp).
	# Qt 6.6 introduit ce --no-undefined, avec une adaptation à FreeBSD (déclaration d'environ en __weak__) qui fonctionne avec GNU ld mais pas avec ld.ldd.
	
	case `uname` in FreeBSD) true ;; *) return ;; esac
	
	# https://github.com/rui314/mold/issues/152#issuecomment-996733517
	# https://bugs.freebsd.org/bugzilla/show_bug.cgi?id=263265 "Utilisez *dlsym(RTLD_DEFAULT, "environ")"
	# https://bugs.freebsd.org/bugzilla/show_bug.cgi?id=265008 "J'ai tenté de faire rentrer environ en weak dans la libc, refusé"
	# https://codereview.qt-project.org/c/qt/qtbase/+/147845 "Qt 5.6 avait explicitement viré ce paramètre pour FreeBSD". Mais peut-être était-ce un ld non lld?
	# https://bugs.freebsd.org/bugzilla/show_bug.cgi?id=220103 "On vire le --no-undefined" (variante via meson)
	
	# À FAIRE: GNU ld a un --ignore-unresolved-symbol,environ; lld a-t-il un équivalent? --undefined=environ semblait prometteur, mais ça ne change rien, le --no-undefined prend le dessus
	#   extern char ** environ; char ** toto() { return environ; }
	#   clang -shared -fPIC -fuse-ld=lld -Wl,--undefined=environ -Wl,--no-undefined -o toto.so toto.c # undefined symbol: environ
	
	# La solution si --undefined=environ fonctionnait:
	#local options="--undefined=environ"
	#filtrer qtbase/cmake/QtFlagHandlingHelpers.cmake sed -e "/no_undefined_flag.*--no-undefined/s/--no-undefined/&,$options/g"
	
	# La solution par dlsym:
	filtrer qtbase/src/corelib/io/qprocess_unix.cpp sed -e '/extern.*environ/{
a\
#include <dlfcn.h>
a\
#define environ (*(char ***)dlsym(RTLD_DEFAULT, "environ"))
}'
}

fqtnConst()
{
	# Une 6.7 avec un clang 19 pète dans qdoc sur 3 erreurs, qui semblent être un durcissement de clang face aux tentatives d'extraction de type C++ sur des const tandis que lui attend des non const.
	# Confirmé en regardant le source d'une 6.8, qui inclut des blocs spécifiques #if LIBCLANG_VERSION_MAJOR >= 19
	
	case "$CC" in clang*) true ;; *) return 0 ;; esac
	local vclang="`versionCompiloChemin clang`"
	pge $vclang 19 || return 0
	modifsPostConf="$modifsPostConf _fqtnConst"
}

_fqtnConst()
{
	filtrer qttools/src/qdoc/qdoc/src/qdoc/clangcodeparser.cpp sed \
		-e '/get_fully_qualified_type_name/s/getDefaultArgument(),/getDefaultArgument().getArgument().getAsType(),/' \
		-e '/get_expression_as_string/s/getDefaultArgument(),/getDefaultArgument().getSourceExpression(),/' \
		-e 's/TemplateName::Qualified::Fully/TemplateName::Qualified::AsWritten/'
}

qtcopy()
{
	local version=r619081
	local archive_svn=svn://anonsvn.kde.org/home/kde/trunk/qt-copy/patches
	pushd . > /dev/null
	pushd /tmp > /dev/null
	obtenirEtAllerDansVersion
	ou="`pwd`"
	popd > /dev/null
	mv "$ou" patches
	for i in patches/*-*.diff
	do
		patch -p0 < "$i" || true # Certains sont vides.
	done
}

