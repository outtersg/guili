v 6.2.0 && v_ossl="< 4" || true
v 6.5.0 && modifsPostConf="$modifsPostConf x11Introuvable" || true
v 6.6.0 && modifsPostConf="$modifsPostConf environFreeBSD" || true
v 6.7.3 && lts= && modifs="$modifs fqtnConst" || true
v 6.8.2 && retirerModif fqtnConst || true
