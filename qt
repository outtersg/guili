set -e

Delirant() { local s2 ; while [ -h "$s" ] ; do s2="`readlink "$s"`" ; case "$s2" in [^/]*) s2="`dirname "$s"`/$s2" ;; esac ; s="$s2" ; done ; } ; SCRIPTS() { local s="`command -v "$0"`" ; [ -x "$s" -o ! -x "$0" ] || s="$0" ; case "$s" in */bin/*sh) case "`basename "$s"`" in *.*) true ;; *sh) s="$1" ;; esac ;; esac ; case "$s" in [^/]*) local d="`dirname "$s"`" ; s="`cd "$d" ; pwd`/`basename "$s"`" ;; esac ; Delirant ; s="`dirname "$s"`" ; Delirant ; SCRIPTS="$s" ; } ; SCRIPTS
. "$SCRIPTS/util.sh"

prerequis="libjpeg libpng giflib dbus"

# Historique des versions gérées

v 3.3.8 || true
v 4.2.2 && modifs="qtcopy" && OPTIONS_CONF="$OPTIONS_CONF -qt-gif -thread -qdbus" || true
v 5.12.12 && prerequis="git cmake \\" && modifs="modules cflagsEnCmake" && OPTIONS_CONF="-qdbus" || true
v 5.15.16 && lts=1 || true
v 6.7.3 && lts= && modifs="$modifs fqtnConst" || true
v 6.8.2 && retirerModif fqtnConst || true

# Pour Qt 5, l'archive publiée ne contient que le lanceur, pas les .git… mais le lanceur chope des git submodules, donc échoue sans ses .git. On doit donc récupérer l'étiquette plutôt que le .tgz
pg 5 $version || versionComplete="$version.HEAD.silo.git" # Le HEAD de l'étiquette qui figure en @$version dans $archive_git. Avec un .silo pour préserver le .git/

# Modifications

modules()
{
	local OPTIONS_INIT="--module-subset=default"
	#OPTIONS_CONF="$OPTIONS_CONF -init-submodules -submodules all"
	#OPTIONS_CONF="$OPTIONS_CONF -submodules all"
	case `uname` in
		FreeBSD)
			# qtquick3dphysics a une #error explicite dans ses .h pour autre chose que Windows, Linux, Mac.
			OPTIONS_INIT="$OPTIONS_INIT,-qtquick3dphysics"
			;;
	esac
	OPTIONS_INIT="$OPTIONS_INIT,-qtcharts" # "Imposs de trouver la rév actuelle" en 6.8.
	[ ! -f guili.initsilos ] || return 0
	if [ -x init-repository.pl ]
	then
		./init-repository.pl $OPTIONS_INIT
	else
		./init-repository $OPTIONS_INIT
	fi
	touch guili.initsilos
}

cflagsEnCmake()
{
	case "$CFLAGS" in
		*-O3*) OPTIONS_CONF="$OPTIONS_CONF -Doptimize_full=true" ;;
	esac
}

