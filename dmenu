set -e

Delibere() { local s2 ; while [ -h "$s" ] ; do s2="`readlink "$s"`" ; case "$s2" in [!/]*) s2="`dirname "$s"`/$s2" ;; esac ; s="$s2" ; done ; } ; SCRIPTS() { local s="`command -v "$0"`" ; [ -x "$s" -o ! -x "$0" ] || s="$0" ; case "$s" in */bin/*sh) case "`basename "$s"`" in *.*) true ;; *sh) s="$1" ;; esac ;; esac ; case "$s" in [!/]*) local d="`dirname "$s"`" ; s="`cd "$d" ; pwd`/`basename "$s"`" ;; esac ; Delibere ; s="`dirname "$s"`" ; Delibere ; SCRIPTS="$s" ; } ; SCRIPTS
. "$SCRIPTS/util.sh"

prerequis="freetype fontconfig"
v 5.4 || true

# Modifications

configurer()
{
	filtrer config.mk sed -e "
/^X11INC *=/s#=.*#= `pkgconf --cflags-only-I x11 | sed -E -e 's/(^| +)-I/ /g'`#
/^X11LIB *=/s#=.*#= `pkgconf --libs-only-L x11 | sed -E -e 's/(^| +)-L/ /g'`#
/^PREFIX *=/s#=.*#= $dest#
/^FREETYPEINC *=/s#=.*#= $destfreetype/include/freetype2#
/^CC *=/s#=.*#= $CC#
/^XINERAMA/s/^/#/
"
}

# Variables

archive=https://dl.suckless.org/tools/dmenu-$version.tar.gz

DPOM

echo Configuration… >&2
configurer

echo Compilation… >&2
make

echo Installation… >&2
sudokupy make install

sutiliser
