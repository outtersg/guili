set -e

Delibere() { local s2 ; while [ -h "$s" ] ; do s2="`readlink "$s"`" ; case "$s2" in [!/]*) s2="`dirname "$s"`/$s2" ;; esac ; s="$s2" ; done ; } ; SCRIPTS() { local s="`command -v "$0"`" ; [ -x "$s" -o ! -x "$0" ] || s="$0" ; case "$s" in */bin/*sh) case "`basename "$s"`" in *.*) true ;; *sh) s="$1" ;; esac ;; esac ; case "$s" in [!/]*) local d="`dirname "$s"`" ; s="`cd "$d" ; pwd`/`basename "$s"`" ;; esac ; Delibere ; s="`dirname "$s"`" ; Delibere ; SCRIPTS="$s" ; } ; SCRIPTS
. "$SCRIPTS/util.sh"

prerequis="autoconf automake m4 libtool \\ iconv"
modifs="usrLocalInclude"
v 0.13.0.20250109 && versionComplete="$version.2c3b811.git" || true

# Modifications

usrLocalInclude()
{
	# On va piocher les en-têtes système sous FreeBSD; pour X11 ça va être utile.
	export CPPFLAGS="$CPPFLAGS -I/usr/local/include"
	export LDFLAGS="$LDFLAGS -L/usr/local/lib -liconv" # -liconv parce qu'ils partent du principe qu'on a un iconv intégré à la libc (ce qui est peut-être le cas sur FreeBSD non modifié, mais avec mes GuiLI mes symboles sont ailleurs).
	export CFLAGS="$CPPFLAGS $CFLAGS" # $CPPFLAGS est utilisé par le configure, mais pas par le Makefile.
}

# Variables

archive_git=https://github.com/astrand/xclip.git

DPOM

echo Configuration… >&2
autoreconf -f -i
./configure --prefix="$dest"

echo Compilation… >&2
make

echo Installation… >&2
sudoku make install

sutiliser
