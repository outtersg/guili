set -e

Delibere() { local s2 ; while [ -h "$s" ] ; do s2="`readlink "$s"`" ; case "$s2" in [!/]*) s2="`dirname "$s"`/$s2" ;; esac ; s="$s2" ; done ; } ; SCRIPTS() { local s="`command -v "$0"`" ; [ -x "$s" -o ! -x "$0" ] || s="$0" ; case "$s" in */bin/*sh) case "`basename "$s"`" in *.*) true ;; *sh) s="$1" ;; esac ;; esac ; case "$s" in [!/]*) local d="`dirname "$s"`" ; s="`cd "$d" ; pwd`/`basename "$s"`" ;; esac ; Delibere ; s="`dirname "$s"`" ; Delibere ; SCRIPTS="$s" ; } ; SCRIPTS
. "$SCRIPTS/util.sh"

v 2.6.8 && prerequis="pkgconf+ig+-strict \\ glib libjpeg libpng libtiff atk >= 1.9 cairo pango+intro" || true
v 2.24.13 && modifs="$modifs putainDeLibJPEGDeMacOSX" && remplacerPrerequis "atk >= 2.5.3" "gdk-pixbuf >= 2.26" "pango+intro >= 1.20 < 1.30" || true
v 3.6.2 && via="meson" && remplacerPrerequis "pango+intro > 1.30" || true

predestiner="$predestiner preoutils presortie"

# Modifications

preoutils()
{
	case "$via" in
		meson)
			prerequis="meson ninja \\ $prerequis"
			configurer="meson setup build --buildtype=release"
			construire="ninja -C build"
			installer="sudoku ninja -C build install"
			;;
		"")
			configurer=./configure
			construire=make
			installer="sudoku make install"
			;;
	esac
}

presortie()
{
mac && optionsConf="--enable-quartz-backend --disable-x11-backend" || true
}

# Variables

archive=https://gitlab.gnome.org/GNOME/gtk/-/archive/$version/gtk-$version.tar.bz2

destiner

prerequis

obtenirEtAllerDansVersion

echo Correction… >&2
for modif in true $modifs ; do $modif ; done

echo Configuration… >&2
$configurer --prefix="$dest" $optionsConf  # Attention à ce que le LDFLAGS soit bien défini: sans, -L/usr/X11R6/lib passe en premier, avec une fontconfig obsolète et incompatible avec celle d'/usr/local (FcObjectStaticName pas utilisée, donc les comparaisons de chaînes merdent).

echo Compilation… >&2
$construire

echo Installation… >&2
$installer

sutiliser
