set -e

Delibere() { local s2 ; while [ -h "$s" ] ; do s2="`readlink "$s"`" ; case "$s2" in [!/]*) s2="`dirname "$s"`/$s2" ;; esac ; s="$s2" ; done ; } ; SCRIPTS() { local s="`command -v "$0"`" ; [ -x "$s" -o ! -x "$0" ] || s="$0" ; case "$s" in */bin/*sh) case "`basename "$s"`" in *.*) true ;; *sh) s="$1" ;; esac ;; esac ; case "$s" in [!/]*) local d="`dirname "$s"`" ; s="`cd "$d" ; pwd`/`basename "$s"`" ;; esac ; Delibere ; s="`dirname "$s"`" ; Delibere ; SCRIPTS="$s" ; } ; SCRIPTS
. "$SCRIPTS/util.sh"

v 1.9.0 && prerequis="make python pkgconfig \\ glib gobject-introspection" || true
v 2.7.2 && remplacerPrerequis "glib >= 2.31.2" && modifs="putainDeLibJPEGDeMacOSX" || true
v 2.13.3 || true
v 2.15.4 || true
v 2.22 || true
v 2.24.0 || true
v 2.25.2 || true # Introduction de meson, en plus d'autoconf.
v 2.26.1 || true
v 2.28.1 || true
v 2.29.1 || true # Plus d'autoconf.
v 2.32.0 || true
v 2.35.1 || true
v 2.38.0 || true

predestiner="$predestiner preoutils"

# Modifications

preoutils()
{
	if pge $version 2.29.1
	then
		prerequis="meson ninja \\ $prerequis"
		configurer="meson setup build --buildtype=release"
		construire="ninja -C build"
		installer="sudoku ninja -C build install"
	else
		# À FAIRE: le gettext à avoir dans la version des fichiers du projet. Ici pour une 2.28.1
		prerequis="autoconf automake m4 libtool gettext >= 0.22 < 0.23 \\ $prerequis"
		configurer=autoconfer
		construire=make
		installer="sudoku make install"
		modifs="$modifs sansGtkDoc"
	fi
}

autoconfer()
{
	[ -f configure ] || NOCONFIGURE=nono ./autogen.sh
	./configure "$@"
	# À FAIRE: le truc suivant demande d'appuyer sur la touche Entrée.
	gettextize -f # Sans quoi "error: gettext infrastructure mismatch: using a Makefile.in.in from gettext version 0.19 but the autoconf macros are from gettext version 0.22"
}

sansGtkDoc()
{
	filtrer autogen.sh grep -v gtkdocize
	filtrer configure.ac egrep -v 'docs/Makefile|GTK_DOC_CHECK'
	[ ! -f configure ] || filtrer configure sed -e 's#docs/Makefile##g'
	rm docs/Makefile.am
	printf 'all:\n\ttrue\ninstall:\n\ttrue\n' > docs/Makefile
}

# Variables

v_() { IFS=_ ; printf %s "$*" ; unset IFS ; }
archive=https://gitlab.gnome.org/Archive/$logiciel/-/archive/$version/$logiciel-$version.tar.gz
pge $version 2.38 ||
archive=https://gitlab.gnome.org/Archive/atk/-/archive/ATK_`IFS=. ; v_ $version`/atk-ATK_`IFS=. ; v_ $version`.tar.gz

destiner

prerequis

obtenirEtAllerDansVersion

echo Correction… >&2
for modif in true $modifs ; do $modif ; done

echo Configuration… >&2
$configurer --prefix="$dest"

echo Compilation… >&2
$construire

echo Installation… >&2
$installer

sutiliser
